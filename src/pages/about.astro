---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';

const bioParagraphs = site.bioLong.trim().split('\n\n');
---

<BaseLayout title="About" description="About TechPaige.">
  <section class="about">
    <div class="wrap about-grid">
      <div class="about-photo">
        <img
          src="/images/about/paige-about.jpg"
          alt="Paige smiling in front of the Made by Google sign at the Made by Google Canadian Preview"
          loading="eager"
        />
      </div>
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h1>Hi, I'm Paige</h1>

        {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}

        <h2>Get in touch</h2>
        <ContactBlock />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 2rem; }

  .about-grid {
    display: grid;
    grid-template-columns: 18rem 1fr;
    gap: 3rem;
    align-items: start;
    max-width: 56rem;
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgba(43, 33, 28, 0.18);
    position: sticky;
    top: 2rem;
  }

  .about-copy { max-width: 42rem; }
  .about-copy h2 { margin-top: 2.5rem; }

  @media (max-width: 780px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-photo img {
      max-width: 16rem;
      aspect-ratio: 3 / 4;
      position: static;
    }
  }
</style>
