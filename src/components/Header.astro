---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;

const links = [
  { href: '/shop', label: 'Shop' },
  { href: '/gear', label: 'Gear' },
  { href: '/blog', label: 'Posts' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/">TechPaige</a>

    <nav class="pill-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class:list={{ active: isActive(link.href) }}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-toggle">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-top: 1.5rem;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'logo nav toggle';
    align-items: center;
    gap: 1rem;
  }

  .logo {
    grid-area: logo;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-text);
    justify-self: start;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .pill-nav {
    grid-area: nav;
  }

  .pill-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0.6rem 1.75rem;
    background: var(--color-surface);
    border-radius: 999px;
    box-shadow: 0 2px 12px rgba(43, 33, 28, 0.1);
  }

  .pill-nav a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .pill-nav a:hover,
  .pill-nav a.active {
    color: var(--color-accent);
    text-decoration: none;
  }

  .header-toggle {
    grid-area: toggle;
    justify-self: end;
  }

  @media (max-width: 720px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo toggle'
        'nav nav';
      row-gap: 1rem;
    }

    .pill-nav {
      justify-self: center;
    }

    .pill-nav ul {
      gap: 1rem;
      padding: 0.5rem 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .pill-nav a {
      font-size: 0.85rem;
    }
  }
</style>
