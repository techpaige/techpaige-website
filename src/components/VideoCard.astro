---
interface Props {
  video: { id: string; title: string; url: string; published: string; thumbnail: string };
}

const { video } = Astro.props;
const formattedDate = new Date(video.published).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="video-card" href={video.url} target="_blank" rel="noopener">
  <div class="video-thumb">
    <img src={video.thumbnail} alt="" loading="lazy" />
    <span class="video-play" aria-hidden="true"></span>
  </div>
  <h3>{video.title}</h3>
  <p class="video-date">{formattedDate}</p>
</a>
