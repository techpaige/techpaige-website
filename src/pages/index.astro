---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import VideoCard from '../components/VideoCard.astro';
import GearCard from '../components/GearCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { site } from '../data/site';
import { gear } from '../data/gear';
import { products } from '../data/products';
import { fetchLatestVideos, CHANNEL_URL } from '../data/youtube.js';

// Latest videos come straight from YouTube. They're baked in at build time,
// then refreshed live from /api/videos (worker/index.js) so a new Friday
// upload shows up without touching the site.
const videos = await fetchLatestVideos(3);
const featuredProducts = products.filter((p) => p.featured).slice(0, 2);

// Break the positioning line onto two lines in the hero after the first
// sentence, without changing the plain-text version used elsewhere (footer, meta).
const [positioningLine1, ...positioningRest] = site.positioning.split(/(?<=\.) /);
const positioningLine2 = positioningRest.join(' ');
---

<BaseLayout title="Home" description={site.bioShort}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-inner">
        <h1>{positioningLine1}{positioningLine2 && <><br />{positioningLine2}</>}</h1>
        <p class="hero-tagline">{site.tagline}</p>
        <p class="hero-subcopy">{site.subcopy}</p>
        <SocialIcons size={22} />
      </div>
      <div class="hero-media">
        <img
          src="/images/hero/hero-desk.jpg"
          alt="A cozy desk flatlay with a laptop, phone, and dried flowers"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="latest-videos">
    <div class="wrap">
      <div class="section-heading">
        <h2>Latest videos</h2>
        <a href={CHANNEL_URL} target="_blank" rel="noopener">Watch on YouTube &rarr;</a>
      </div>
      <div class="grid grid-videos" data-video-grid>
        {videos.map((video) => <VideoCard video={video} />)}
      </div>
      {videos.length === 0 && (
        <p class="videos-fallback" data-video-fallback>
          New videos every Friday. <a href={CHANNEL_URL} target="_blank" rel="noopener">Catch up on YouTube &rarr;</a>
        </p>
      )}
    </div>
  </section>

  <section class="gear-strip">
    <div class="wrap">
      <div class="section-heading">
        <h2>What I'm using</h2>
        <a href="/gear">See the full list &rarr;</a>
      </div>
      <div class="grid grid-gear">
        {gear.slice(0, 4).map((item) => <GearCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="shop-teaser">
    <div class="wrap">
      <div class="section-heading">
        <h2>From the shop</h2>
        <a href="/shop">View all products &rarr;</a>
      </div>
      <div class="grid grid-2">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Refresh the video row from the live feed. If anything fails, the
  // build-time videos (or the fallback line) simply stay put.
  const grid = document.querySelector('[data-video-grid]');
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  fetch('/api/videos')
    .then((r) => (r.ok ? r.json() : []))
    .then((videos: { title: string; url: string; published: string; thumbnail: string }[]) => {
      if (!grid || !Array.isArray(videos) || videos.length === 0) return;
      grid.innerHTML = videos
        .map((v) => {
          const date = new Date(v.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          return `<a class="video-card" href="${esc(v.url)}" target="_blank" rel="noopener">
            <div class="video-thumb"><img src="${esc(v.thumbnail)}" alt="" loading="lazy" /><span class="video-play" aria-hidden="true"></span></div>
            <h3>${esc(v.title)}</h3>
            <p class="video-date">${date}</p>
          </a>`;
        })
        .join('');
      document.querySelector('[data-video-fallback]')?.remove();
    })
    .catch(() => {});
</script>

<style>
  .hero {
    padding: 3rem 0 4rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-inner h1 {
    margin-bottom: 0.75rem;
    max-width: 30rem;
  }

  .hero-tagline {
    font-size: 1.15rem;
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .hero-subcopy {
    font-size: 1.15rem;
    opacity: 0.9;
    max-width: 32rem;
    margin-bottom: 1.5rem;
  }

  .hero-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgba(43, 33, 28, 0.18);
  }

  @media (max-width: 780px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-media {
      order: -1;
    }

    .hero-media img {
      aspect-ratio: 16 / 10;
    }
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-heading h2 { margin: 0; }

  .grid-videos {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .videos-fallback {
    margin: 0;
    opacity: 0.85;
  }

  .grid-gear {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .shop-teaser {
    background: var(--color-muted);
  }
</style>
