---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';

const bioParagraphs = site.bioLong.trim().split('\n\n');
---

<BaseLayout title="About" description="About TechPaige.">
  <section class="about">
    <div class="wrap about-inner">
      <p class="eyebrow">About</p>
      <h1>Hi, I'm Paige</h1>

      {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}

      <div class="about-photo">
        <img
          src="/images/about/paige-about.jpg"
          alt="Paige smiling in front of the Made by Google sign at the Made by Google Canadian Preview"
          loading="eager"
        />
      </div>

      <h2>Get in touch</h2>
      <ContactBlock />
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 2rem; }
  .about-inner { max-width: 42rem; }
  .about-inner h2 { margin-top: 2.5rem; }

  .about-photo {
    margin: 2rem 0;
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 1.5rem;
    box-shadow: 0 16px 40px rgba(43, 33, 28, 0.18);
  }
</style>
