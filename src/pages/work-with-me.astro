---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, brandOfferings } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout
  title="Work With Me"
  description="Brand partnerships and client services from TechPaige: YouTube reviews, UGC, videography, photography, editing, and same-day event content."
>
  <section class="page-header services-hero">
    <div class="wrap">
      <p class="eyebrow">Work With Me</p>
      <h1>Let's make something good</h1>
      <p class="page-intro">
        I take on a small number of brand partnerships and client projects each season,
        so every one gets my full attention.
      </p>

      <div class="tabs" role="tablist" aria-label="Who are you?">
        <button class="tab" role="tab" id="tab-brands" aria-controls="brands" aria-selected="true" data-tab="brands">For Brands</button>
        <button class="tab" role="tab" id="tab-clients" aria-controls="clients" aria-selected="false" data-tab="clients">For Clients</button>
      </div>
    </div>
  </section>

  <section class="services panel" id="brands" role="tabpanel" aria-labelledby="tab-brands">
    <div class="wrap">
      <div class="panel-intro">
        <h2>Brand partnerships</h2>
        <p class="page-intro">
          I partner with tech and lifestyle brands whose products I would actually use. Everything
          I share is tested in my real, everyday life first, because my audience trusts me to keep
          it honest. No jargon, no judgment.
        </p>
      </div>
      <div class="service-grid">
        {brandOfferings.map((s) => (
          <article class="service-card">
            <h3 class="service-title">{s.title}</h3>
            {s.badge && <span class="badge">{s.badge}</span>}
            <p>{s.blurb}</p>
            <ul>
              {s.includes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services panel" id="clients" role="tabpanel" aria-labelledby="tab-clients">
    <div class="wrap">
      <div class="panel-intro">
        <h2>Client services</h2>
        <p class="page-intro">
          Before TechPaige was a channel, it was a videography studio. I still take on select
          projects for businesses, couples, and events.
        </p>
        <p class="page-intro small">
          Based in Durham Region, working across the GTA. Remote editing and content work welcome.
        </p>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <article class="service-card">
            <h3 class="service-title">{s.title}</h3>
            {s.badge && <span class="badge">{s.badge}</span>}
            <p>{s.blurb}</p>
            <ul>
              {s.includes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <h3>Inquire</h3>
          <p>Tell me about your product or project below. The more detail, the better.</p>
        </li>
        <li>
          <span class="step-num">2</span>
          <h3>Quick chat</h3>
          <p>If it feels like a fit, we will hop on a short call to talk goals, deliverables, and timing.</p>
        </li>
        <li>
          <span class="step-num">3</span>
          <h3>Custom quote</h3>
          <p>Every partnership and project is different, so pricing is quoted based on scope.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="inquire" id="inquire">
    <div class="wrap inquire-inner">
      <h2>Let's talk</h2>
      <p class="page-intro">
        I read every inquiry and reply to the ones that feel like a great fit within a few days.
      </p>

      <form id="inquiry-form" class="inquiry-form" novalidate>
        <div class="row">
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>

        <div class="row">
          <label>
            <span>Business or brand <em>(optional)</em></span>
            <input type="text" name="business" autocomplete="organization" />
          </label>
          <label>
            <span>I'm interested in</span>
            <select name="service" id="service-select" required>
              <option value="" selected disabled>Choose one</option>
              <optgroup label="Brand partnerships">
                {brandOfferings.map((s) => <option value={`Brand: ${s.title}`}>{s.title}</option>)}
              </optgroup>
              <optgroup label="Client services">
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
              </optgroup>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </label>
        </div>

        <div class="row">
          <label>
            <span>Date, timeline, or launch</span>
            <input type="text" name="timeline" placeholder="e.g. June 14, or flexible in spring" />
          </label>
          <label>
            <span>Budget <em>(optional)</em></span>
            <select name="budget">
              <option value="" selected>Prefer not to say</option>
              <option>Under $500</option>
              <option>$500 to $1,500</option>
              <option>$1,500 to $3,000</option>
              <option>$3,000+</option>
            </select>
          </label>
        </div>

        <label>
          <span>Project details</span>
          <textarea name="message" rows="6" required placeholder="What are you working on, and what would a win look like? Brands: share the product and campaign goals."></textarea>
        </label>

        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="from_name" value="TechPaige Website" />
        <input type="hidden" name="subject" value="New Work With Me inquiry" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button class="btn" type="submit">Send inquiry</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
      <p class="fallback">
        Prefer email? Reach me at <a href={`mailto:${site.email}?subject=Work%20with%20me`}>{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Tabs: For Brands / For Clients. /work-with-me#clients opens the client tab,
  // anything else (including #brands) opens the brand tab.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function show(id: string, updateHash = false) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
    panels.forEach((p) => (p.hidden = p.id !== id));
    if (updateHash) history.replaceState(null, '', `#${id}`);
  }

  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!, true)));
  show(location.hash === '#clients' ? 'clients' : 'brands');
  // Keep the tab switch in view when arriving from a #brands / #clients link.
  if (location.hash === '#brands' || location.hash === '#clients') {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.addEventListener('load', () => setTimeout(() => window.scrollTo(0, 0), 0));
  }

  // Inquiry form
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    if (status) status.textContent = 'Sending...';

    const data = new FormData(form);
    // Put the service and sender in the subject so inquiries are easy to scan in Gmail.
    data.set('subject', `New inquiry: ${data.get('service') || 'Work With Me'} from ${data.get('name')}`);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: data,
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error();
      form.reset();
      if (status) status.textContent = 'Thank you! Your inquiry is in. I will be in touch if it is a fit.';
    } catch {
      if (status) status.textContent = 'Something went wrong. Please email me directly at hello@techpaige.ca.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .services-hero { padding: 2rem 0 2.5rem; }
  .page-intro { max-width: 40rem; opacity: 0.9; }
  .page-intro.small { font-size: 0.95rem; opacity: 0.75; }

  .services { padding: 3rem 0 1rem; }
  .panel-intro { margin-bottom: 2rem; }
  .panel-intro h2 { margin-bottom: 0.4em; }

  .tabs {
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding: 0.3rem;
    background: var(--color-surface);
    border-radius: 999px;
    box-shadow: 0 2px 12px rgba(43, 33, 28, 0.1);
  }
  .tab {
    font: inherit;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text);
    background: transparent;
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1.4rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .tab[aria-selected='true'] {
    background: var(--color-accent);
    color: var(--color-cream);
  }
  .tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.75rem;
    box-shadow: 0 2px 12px rgba(43, 33, 28, 0.08);
  }
  .service-title { font-size: 1.5rem; }
  .badge {
    display: inline-block;
    margin: -0.15rem 0 0.85rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-espresso);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .service-card ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .service-card li::marker { color: var(--color-accent); }

  .process { padding: 3rem 0 1rem; }
  .steps {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }
  .steps h3 { font-size: 1.35rem; margin-top: 0.5rem; }
  .steps p { opacity: 0.85; }
  .step-num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-espresso);
    font-weight: 600;
  }

  .inquire { padding: 3rem 0 1rem; }
  .inquire-inner { max-width: 44rem; }
  .inquiry-form { display: grid; gap: 1.1rem; margin-top: 1.5rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { display: grid; gap: 0.35rem; font-weight: 500; font-size: 0.95rem; }
  label em { font-style: normal; opacity: 0.6; font-weight: 400; }
  input, select, textarea {
    font: inherit;
    font-weight: 400;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1.5px solid var(--color-bg-secondary);
    border-radius: var(--radius);
    padding: 0.7rem 0.85rem;
    width: 100%;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .inquiry-form .btn { justify-self: start; }
  .inquiry-form .btn:disabled { opacity: 0.6; cursor: wait; }
  .form-status { margin: 0; min-height: 1.5em; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fallback { margin-top: 2rem; font-size: 0.95rem; opacity: 0.85; }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
