---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="card product-card">
  <img src={product.image} alt={product.name} loading="lazy" />
  <div class="product-card-body">
    <span class="tag">{product.category}</span>
    <h3>{product.name}</h3>
    <p class="product-description">{product.description}</p>
    <div class="product-footer">
      <span class="price">{product.price}</span>
      {product.live ? (
        <div class="product-links">
          <a class="btn" href={product.gumroadUrl} target="_blank" rel="noopener noreferrer">
            Get it on Gumroad
          </a>
          {product.etsyUrl && (
            <a class="btn btn-outline" href={product.etsyUrl} target="_blank" rel="noopener noreferrer">
              Etsy
            </a>
          )}
        </div>
      ) : (
        <span class="coming-soon">Coming soon</span>
      )}
    </div>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--color-muted);
  }

  .product-card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .product-description {
    margin: 0;
    opacity: 0.85;
    flex: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .price {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .product-links {
    display: flex;
    gap: 0.5rem;
  }

  .btn {
    font-size: 0.9rem;
    padding: 0.6em 1.1em;
  }

  .coming-soon {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-muted-foreground, currentColor);
    opacity: 0.6;
    padding: 0.6em 0.2em;
  }
</style>
