---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, heroImage } = post.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="post-row" href={`/blog/${post.slug}`}>
  {heroImage && (
    <div class="post-row-thumb">
      <img src={heroImage} alt="" loading="lazy" />
    </div>
  )}
  <div class="post-row-body">
    {category === 'amazon-finds' && <span class="tag tag-accent">Amazon Finds</span>}
    <h3>{title}</h3>
    <p class="post-row-description">{description}</p>
    <p class="post-row-date">{formattedDate}</p>
  </div>
</a>

<style>
  .post-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-muted);
    color: var(--color-text);
  }

  .post-row:first-child {
    padding-top: 0;
  }

  .post-row:hover {
    text-decoration: none;
  }

  .post-row:hover h3 {
    color: var(--color-accent);
  }

  .post-row-thumb {
    flex: 0 0 auto;
    width: 7rem;
    height: 5.25rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-muted);
  }

  .post-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-row-body {
    flex: 1;
    min-width: 0;
  }

  .post-row-body h3 {
    margin: 0.15rem 0 0.35rem;
    transition: color 0.15s ease;
    font-size: 1.35rem;
  }

  .post-row-description {
    margin: 0 0 0.35rem;
    opacity: 0.85;
  }

  .post-row-date {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 560px) {
    .post-row-thumb {
      width: 4.5rem;
      height: 4.5rem;
    }

    .post-row-body h3 {
      font-size: 1.15rem;
    }
  }
</style>
