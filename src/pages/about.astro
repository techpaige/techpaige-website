---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';

const bioParagraphs = site.bioLong.trim().split('\n\n');
---

<BaseLayout title="About" description="About TechPaige.">
  <section class="about">
    <div class="wrap about-inner">
      <p class="eyebrow">About</p>
      <h1>Hi, I'm Paige</h1>

      {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}

      <h2>Get in touch</h2>
      <ContactBlock />
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 2rem; }
  .about-inner { max-width: 42rem; }
  .about-inner h2 { margin-top: 2.5rem; }
</style>
