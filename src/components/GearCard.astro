---
import type { GearItem } from '../data/gear';

interface Props {
  item: GearItem;
}

const { item } = Astro.props;
---

<div class="gear-card">
  {item.url ? (
    <a class="gear-image-link" href={item.url} target="_blank" rel="noopener sponsored" aria-label={`Shop ${item.name} on Amazon`}>
      <img src={item.image} alt="" loading="lazy" />
    </a>
  ) : (
    <img src={item.image} alt="" loading="lazy" />
  )}
  <p class="gear-name">{item.name}</p>
  <p class="gear-note">{item.note}</p>
  {item.url && (
    <a class="gear-link" href={item.url} target="_blank" rel="noopener sponsored">
      Shop on Amazon &rarr;
    </a>
  )}
</div>

<style>
  .gear-card {
    text-align: left;
  }

  .gear-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
    display: block;
  }

  .gear-image-link {
    display: block;
    transition: opacity 0.15s ease;
  }

  .gear-image-link:hover {
    opacity: 0.85;
  }

  .gear-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }

  .gear-note {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .gear-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-accent);
  }
</style>
